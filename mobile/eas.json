{
  "cli": {
    "version": ">= 10.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SHOPFIA_API_URL": "https://www.shopfia.app"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
